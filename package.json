{
  "name": "labs",
  "private": true,
  "version": "0.3.3",
  "description": "TailLabs — TL001 蛇貂堆疊 / TL002 蛇貂逃家了 / TL003 無盡防線 Web prototypes",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:tl001": "node tools/build-tl001-art.mjs && node tools/build-magic-circle.mjs && node tools/build-tutorial.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:tl002": "vite --config vite.tl002.config.ts",
    "dev:tl003": "vite --config vite.tl003.config.ts",
    "dev:tl004": "vite --config vite.tl004.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:tl002": "node --experimental-strip-types --test tests/runner*.test.mjs",
    "test:tl003": "node --experimental-strip-types --test tests/tl003*.test.mjs",
    "test:tl004": "node --experimental-strip-types --test tests/tl004*.test.mjs",
    "balance:tl003": "node --experimental-strip-types --no-warnings tools/tl003-balance.mjs",
    "typecheck:tl003": "tsc --noEmit -p tsconfig.tl003.json",
    "typecheck:tl002": "tsc --noEmit -p tsconfig.tl002.json",
    "typecheck:tl004": "tsc --noEmit -p tsconfig.tl004.json",
    "prebuild": "node tools/clean-dist.mjs",
    "build": "npm run typecheck && vite build && npm run build:tl002 && npm run build:tl003 && npm run build:tl004 && node tools/build-commission.mjs",
    "build:tl003": "npm run typecheck:tl003 && vite build --config vite.tl003.config.ts",
    "preview:tl003": "vite preview --config vite.tl003.config.ts",
    "build:tl004": "npm run typecheck:tl004 && vite build --config vite.tl004.config.ts",
    "preview:tl004": "vite preview --config vite.tl004.config.ts",
    "build:tl002": "npm run typecheck:tl002 && vite build --config vite.tl002.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "preview:tl002": "vite preview --config vite.tl002.config.ts",
    "art:tl003": "node --no-warnings tools/build-tl003-art.mjs",
    "art:tl004": "node tools/build-tl004-art.mjs",
    "levels:tl004": "node --experimental-strip-types --no-warnings tools/tl004-balance.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "pxl-pixelart": "github:crsolver/claude-pxl#21fee41f7ecce00bc868d7567f24ffd0f3acc8fa",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
